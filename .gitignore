# =========================
# ML generated artifacts
# =========================
**/models/
# The ECD grading spec holds only cut points and aggregate counts (no tissue-level data)
!ml-service/models/
ml-service/models/*
!ml-service/models/grading_ecd_tree.json
# Feature schema and domain-validator classifier/evaluation: small JSON, no tissue-level data.
!ml-service/models/grading_feature_schema.json
# Hybrid grading model and its metadata; regenerate with ml/grading/scripts/train_hybrid_grading_model.py.
# Its ResNet-50 backbone (models/grading_backbone/, ≈94 MB) stays ignored and is regenerated by the Docker build.
!ml-service/models/grading_hybrid_rf.joblib
!ml-service/models/grading_hybrid_rf.json
!ml-service/models/domain_validator/
ml-service/models/domain_validator/*
!ml-service/models/domain_validator/*.json
# The ONNX backbone (≈45 MB) is regenerated by the Docker build; see ml-service/README.md.
**/checkpoints/
**/outputs/
**/runs/

