/ml/disease - new/data/

# =========================
# ML generated artifacts
# =========================
**/models/
# The ECD grading spec holds only cut points and aggregate counts (no tissue-level data)
!ml-service/models/
ml-service/models/*
!ml-service/models/grading_ecd_tree.json
# Feature schema and domain-validator classifier/evaluation: small JSON, no tissue-level data.
!ml-service/models/grading_feature_schema.json
# Hybrid grading model and its metadata; regenerate with ml/grading/scripts/train_hybrid_grading_model.py.
# Its ResNet-50 backbone (models/grading_backbone/, ≈94 MB) stays ignored and is regenerated by the Docker build.
!ml-service/models/grading_hybrid_rf.joblib
!ml-service/models/grading_hybrid_rf.json
# Recommendation matching ranker: logistic coefficients and aggregate scaling only (no tissue-level data).
# Regenerate with: cd ml; uv run python -m recommendation.main export
!ml-service/models/recommendation_ranker.json
!ml-service/models/domain_validator/
ml-service/models/domain_validator/*
!ml-service/models/domain_validator/*.json
# v2 disease + severity models: ONNX exports of the trained weights, their runtime config
# (scaling, thresholds, check limits; aggregate values only) and the unusual-image reference
# (DenseNet features of the training images). Regenerate with ml/disease-new/scripts/.
# The .pt training weights and the result summaries stay ignored.
!ml-service/models/disease_v2/
ml-service/models/disease_v2/*
!ml-service/models/disease_v2/corneal_config.json
!ml-service/models/disease_v2/*.onnx
!ml-service/models/disease_v2/ood_reference_v2.npz
# Records of backbones verified on this machine (written by the export scripts).
ml-service/models/**/*.verified.json
# The ONNX backbone (≈45 MB) is regenerated by the Docker build; see ml-service/README.md.
**/checkpoints/
**/outputs/
**/runs/

