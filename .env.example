DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=
DB_PASSWORD=

# --- Authentication ---
# Required. Base64 HMAC key of at least 256 bits: openssl rand -base64 48
JWT_SECRET=
# Optional overrides (defaults shown)
# JWT_ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_REMEMBER_ME_TTL=7d
# REFRESH_TOKEN_SESSION_TTL=12h
# Keep true in production (HTTPS). Browsers accept Secure cookies on http://localhost.
# AUTH_COOKIE_SECURE=true
# Only needed if the frontend calls the API cross-origin instead of via the /api proxy
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Field-level encryption of sensitive data ---
# Required. Two different base64 keys of 256 bits: openssl rand -base64 32
# Store them apart from the database credentials. Losing DATA_ENCRYPTION_KEY makes the encrypted fields unreadable.
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
# Id written into every ciphertext; change it (and keep the old key as APP_CRYPTO_RETIREDDATAKEYS_<old id>) to rotate.
# DATA_ENCRYPTION_KEY_ID=k1

# --- First administrator (used once, only while no ADMIN exists) ---
# Remove BOOTSTRAP_ADMIN_PASSWORD after the first successful start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FULL_NAME=System Administrator

# --- Image storage (Supabase Storage) ---
# Server-only. The backend uploads and reads specular microscopy images with the
# service-role key; it is never sent to the browser. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The bucket must exist and be PRIVATE (the backend refuses a public bucket).
SUPABASE_STORAGE_BUCKET=specular-images
# Optional upload limits (defaults shown); keep in line with ml-service's IMAGE_* settings.
# IMAGE_MAX_BYTES=15728640
# IMAGE_MIN_SIDE=224
# IMAGE_MAX_SIDE=8000
# IMAGE_MAX_PIXELS=40000000
